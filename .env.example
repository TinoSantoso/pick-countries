# RESTCOUNTRIES_API_KEY — paste your key from https://restcountries.com/sign-up here.
# The demo key rc_live_demo works for development; it returns a shape-accurate sample, not the full dataset.
RESTCOUNTRIES_API_KEY=

# Optional overrides (defaults shown)
PORT=3000
REFRESH_TTL_MS=86400000
UPSTREAM_TIMEOUT_MS=10000
LOG_LEVEL=info
